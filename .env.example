# ===== 阿里云百炼（DashScope）API Key（必填）=====
# 控制台获取：https://bailian.console.aliyun.com/?tab=model#/api-key
# 北京地域 key 与新加坡(intl) key 不同；本项目默认走北京。
DASHSCOPE_API_KEY=sk-your-api-key-here

# ===== 三个模型（均可按需替换）=====
STT_MODEL=fun-asr-realtime
LLM_MODEL=qwen3.7-plus
TTS_MODEL=cosyvoice-v3-flash

# TTS 音色。
# - cosyvoice-v3-flash / v3-plus / v2：可用系统音色，如 longanyang(龙安洋)、longxiaochun(龙小纯)、longwan(龙婉)、longcheng(龙诚)、longhua(龙桦) 等
# - cosyvoice-v3.5-flash / v3.5-plus：仅北京区、无系统音色，必须先在百炼做「声音复刻/声音设计」拿到 voice id 后填到这里
TTS_VOICE=longanyang
TTS_SAMPLE_RATE=24000

# ===== LLM 行为 =====
LLM_SYSTEM_PROMPT=你是一个简洁友好的中文语音助手。请用 1-2 句话简短回答，口语化、适合语音播报，不要使用 markdown 或列表。当需要看用户周围画面时（例如用户问『这是什么』『前面有什么』），先调用 take_photo 拍照再回答。当用户明确表达结束对话（如『再见／拜拜／结束对话／不聊了／先这样吧／挂了』）时，可先用一句话简短告别，并调用 end_conversation 工具结束对话；无明确结束意图时不要调用。
LLM_TEMPERATURE=0.7

# ===== STT 行为（影响端点检测/延迟）=====
# 句尾静音毫秒数，越小越快判定一句话结束（200-6000）
MAX_SENTENCE_SILENCE=800

# ===== 对话行为 =====
# 助手说话时用户开口是否立即打断（barge-in）
ENABLE_BARGE_IN=true
# 前端语音门控（VAD）灵敏度 0-100，越大越易触发（挡更多背景噪声则调低）；仅作前端默认值
# 默认 70（偏灵敏）：缩短开口确认延迟，利好低延迟对话与 barge-in
VAD_SENSITIVITY=70
# 回声检测（外放自循环防护）：speaking 期间/结束后 hangover 内，STT final 与最近 TTS
# 文本相似度超阈值则判为回声丢弃。ENABLE_ECHO_DETECT=false 关闭；阈值越低越激进判回声。
ENABLE_ECHO_DETECT=true
ECHO_SIMILARITY_THRESHOLD=0.6
ECHO_HANGOVER_MS=1200
# 空闲超时：listening 期间无活动达此秒数则播报提示语并自动断开。ENABLE_IDLE_TIMEOUT=false 关闭
ENABLE_IDLE_TIMEOUT=true
IDLE_TIMEOUT=15
# 超时提示语（固定文案，直接喂 TTS，不经 LLM）
IDLE_PROMPT=你好像暂时不需要我了，我先挂啦，需要时随时叫我。

# ===== 低延迟优化（参考 HuggingFace speech-to-speech；每项独立开关，可回滚）=====
# 端到端延迟埋点：每轮首包下发 {total_ms, tts_first_ms, llm_ttft_ms}（前端控制台 + hint 显示）
ENABLE_LATENCY_METRIC=true
# 句子切分细化：LLM 输出按逗号/冒号等子句切分喂 TTS，更早出首包（false 退回仅句末标点）
ENABLE_COMMA_SPLIT=true
# 句子切分长度兜底：无标点时累积到此字数也强制 flush 一段（0=禁用）
SENTENCE_SPLIT_MAX_LEN=12
# 前端 VAD 驱动 turn-end：用 onSpeechEnd 提前触发（替代等 STT 句末 final ~800ms）
ENABLE_VAD_TURN_END=true
# 前端本地 barge-in：speaking 期 VAD 检测到开口即本地停播 + 上行 cancel（false 回退纯服务端）
ENABLE_LOCAL_BARGE_IN=true

# ===== 视觉 / tool-calling =====
# 是否启用视觉（take_photo 工具，qwen3.7-plus 多模态）
ENABLE_VISION=true
# 拍照最长边像素（前端抓帧 resize）
PHOTO_MAX_SIZE=640
# JPEG 质量 0-1
PHOTO_QUALITY=0.8
# 拍照超时（秒）：后端发 take_photo 后等前端回传的最长时间
TAKE_PHOTO_TIMEOUT=5
# 每轮对话工具调用上限（防 LLM 循环）
MAX_TOOL_CALLS_PER_TURN=3
# 是否启用「语义结束对话」（说再见等由 LLM 调 end_conversation 结束）
ENABLE_END_BY_VOICE=true

# ===== MCP（外部工具服务器）=====
# 是否启用 MCP 接入
ENABLE_MCP=true
# MCP 配置文件路径（mcpServers 格式）
MCP_CONFIG_FILE=mcp.json

# ===== 服务监听 =====
HOST=127.0.0.1
PORT=8000

# ===== 高级：地域端点（一般不用改）=====
# LLM OpenAI 兼容地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STT/TTS WebSocket 地址（北京）
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
