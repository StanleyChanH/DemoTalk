# ===== 阿里云百炼（DashScope）API Key（必填）=====
# 控制台获取：https://bailian.console.aliyun.com/?tab=model#/api-key
# 北京地域 key 与新加坡(intl) key 不同；本项目默认走北京。
DASHSCOPE_API_KEY=sk-your-api-key-here

# ===== 三个模型（均可按需替换）=====
STT_MODEL=fun-asr-realtime
LLM_MODEL=qwen3.7-plus
TTS_MODEL=cosyvoice-v3-flash

# TTS 音色。
# - cosyvoice-v3-flash / v3-plus / v2：可用系统音色，如 longanyang(龙安洋)、longxiaochun(龙小纯)、longwan(龙婉)、longcheng(龙诚)、longhua(龙桦) 等
# - cosyvoice-v3.5-flash / v3.5-plus：仅北京区、无系统音色，必须先在百炼做「声音复刻/声音设计」拿到 voice id 后填到这里
TTS_VOICE=longanyang
TTS_SAMPLE_RATE=24000

# ===== LLM 行为 =====
LLM_SYSTEM_PROMPT=你是一个简洁友好的中文语音助手。请用 1-2 句话简短回答，口语化、适合语音播报，不要使用 markdown 或列表。
LLM_TEMPERATURE=0.7

# ===== STT 行为（影响端点检测/延迟）=====
# 句尾静音毫秒数，越小越快判定一句话结束（200-6000）
MAX_SENTENCE_SILENCE=800

# ===== 对话行为 =====
# 助手说话时用户开口是否立即打断（barge-in）
ENABLE_BARGE_IN=true

# ===== 服务监听 =====
HOST=127.0.0.1
PORT=8000

# ===== 高级：地域端点（一般不用改）=====
# LLM OpenAI 兼容地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STT/TTS WebSocket 地址（北京）
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
